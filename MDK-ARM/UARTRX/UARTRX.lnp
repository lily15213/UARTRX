--cpu Cortex-M3
"uartrx\startup_stm32f103xb.o"
"uartrx\main.o"
"uartrx\stm32f1xx_it.o"
"uartrx\stm32f1xx_hal_msp.o"
"uartrx\stm32f1xx_hal_gpio_ex.o"
"uartrx\stm32f1xx_hal_tim.o"
"uartrx\stm32f1xx_hal_tim_ex.o"
"uartrx\stm32f1xx_hal_uart.o"
"uartrx\stm32f1xx_hal.o"
"uartrx\stm32f1xx_hal_rcc.o"
"uartrx\stm32f1xx_hal_rcc_ex.o"
"uartrx\stm32f1xx_hal_gpio.o"
"uartrx\stm32f1xx_hal_dma.o"
"uartrx\stm32f1xx_hal_cortex.o"
"uartrx\stm32f1xx_hal_pwr.o"
"uartrx\stm32f1xx_hal_flash.o"
"uartrx\stm32f1xx_hal_flash_ex.o"
"uartrx\stm32f1xx_hal_exti.o"
"uartrx\system_stm32f1xx.o"
--strict --scatter "UARTRX\UARTRX.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "UARTRX.map" -o UARTRX\UARTRX.axf